# Copy to .env before running `npm run dev` (.env is gitignored - never commit it).
# Session 3 adds the database. DATABASE_URL is read by src/config.ts (dev) and
# loaded via dotenv in prisma.config.ts / prisma/seed.ts.
PORT=3000
DATABASE_URL=postgresql://eventify:eventify@localhost:5433/eventify?schema=public

# Session 5 infra. Redis backs the cache, rate limiter, and BullMQ queue.
# Matches the `redis:8` service in docker-compose.yml.
REDIS_URL=redis://localhost:6379
