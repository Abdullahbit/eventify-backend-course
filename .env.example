# Copy to .env before running `npm run dev` (.env is gitignored - never commit it).
# Session 3 adds the database. DATABASE_URL is read by src/config.ts (dev) and
# loaded via dotenv in prisma.config.ts / prisma/seed.ts.
PORT=3000
DATABASE_URL=postgresql://eventify:eventify@localhost:5432/eventify?schema=public
