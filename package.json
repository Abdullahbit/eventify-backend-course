{
  "name": "eventify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eventify - the event booking API built across the course",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "worker": "node --watch --env-file=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test --test-timeout=30000 src/tests/run-all.ts",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "db:up": "docker compose up -d",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.5.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.0.0",
    "eslint": "^9.30.0",
    "prisma": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "supertest": "^6.3.4",
    "@prisma/client": "^7.9.1",
    "express": "^5.2.1",
    "zod": "^4.4.3",
    "bullmq": "^6.0.0",
    "redis": "^5.0.0"
  },
  "allowScripts": {
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true
  }
}
