{
  "name": "eventify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Eventify - the event booking API built across the course",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "echo \"No tests yet - Vitest arrives in Session 6\" && exit 0",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "db:up": "docker compose up -d",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.5.0",
    "dotenv": "^17.0.0",
    "eslint": "^9.30.0",
    "prisma": "^7.9.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  }
}
